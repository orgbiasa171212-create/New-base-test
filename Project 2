            };
        }

        let appState = cloneDefaultState();

        // ==================== 2. NORMALISASI & SINKRONISASI CLOUD ====================
        function normalizeCloudDoc(rawDoc) {
            const base = cloneDefaultState();
            if (!rawDoc || typeof rawDoc !== 'object') return base;

            let parsedSessions = {};
            if (typeof rawDoc.inProgressSessions === 'string') {
                try {
                    parsedSessions = JSON.parse(rawDoc.inProgressSessions) || {};
                } catch (_) {
                    parsedSessions = {};
                }
            } else if (rawDoc.inProgressSessions && typeof rawDoc.inProgressSessions === 'object') {
                parsedSessions = rawDoc.inProgressSessions;
            }

            return {
                examSettings: {
                    ...base.examSettings,
                    ...(rawDoc.examSettings || {})
                },
                users: Array.isArray(rawDoc.users) ? rawDoc.users : base.users,
                questions: Array.isArray(rawDoc.questions) ? rawDoc.questions : base.questions,
                submissions: Array.isArray(rawDoc.submissions) ? rawDoc.submissions : base.submissions,
                inProgressSessions: parsedSessions || {}
            };
        }

        function saveLocalMirror(stateObj) {
            try {
                localStorage.setItem(LOCAL_CLOUD_FALLBACK_KEY, JSON.stringify(stateObj));
            } catch (_) {
                // Abaikan jika storage penuh
            }
        }

        function loadLocalMirror() {
            try {
                const raw = localStorage.getItem(LOCAL_CLOUD_FALLBACK_KEY);
                if (!raw) return null;
                return normalizeCloudDoc(JSON.parse(raw));
            } catch (_) {
                return null;
            }
        }

        function updateSyncStatusBadge(text) {
            cloudSyncStatus = text;
            const badge = document.getElementById('cloudSyncBadge');
            if (badge) {
                const span = badge.querySelector('span');
                if (span) span.textContent = text;
            }
        }

        async function persistCloudState() {
            saveLocalMirror(appState);

            if (!db || !authUser) {
                updateSyncStatusBadge('Tersimpan Lokal & Siap Sinkron');
                return;
            }

            try {
                updateSyncStatusBadge('Menyimpan ke Cloud...');
                const stateDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'cbt_state', 'master');
                const payload = {
                    examSettings: appState.examSettings,
                    users: appState.users,
                    questions: appState.questions,
                    submissions: appState.submissions,
                    inProgressSessions: JSON.stringify(appState.inProgressSessions || {}),
                    updatedAt: new Date().toISOString()
                };
                await setDoc(stateDocRef, payload, { merge: true });
                updateSyncStatusBadge('Cloud Tersinkronisasi');
            } catch (err) {
                console.error('Gagal menyimpan ke Firestore:', err);
                updateSyncStatusBadge('Tersimpan Lokal (Mode Offline)');
            }
        }

        // ==================== 3. HELPER UTILITAS & KEAMANAN ====================
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function isCurrentUserAdmin() {
            return Boolean(currentUser && currentUser.role === 'admin');
        }

        function formatDateTimeDisplay(isoLocal) {
            if (!isoLocal) return '-';
            const d = new Date(isoLocal);
            if (Number.isNaN(d.getTime())) return isoLocal;
            return d.toLocaleString('id-ID', {
                weekday: 'short',
                day: '2-digit',
                month: 'short',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function formatSeconds(totalSec) {
            const sec = Math.max(0, Math.floor(Number(totalSec) || 0));
            const h = Math.floor(sec / 3600);
            const m = Math.floor((sec % 3600) / 60);
            const s = sec % 60;
            const pad = (n) => String(n).padStart(2, '0');
            return h > 0 ? `${pad(h)}:${pad(m)}:${pad(s)}` : `${pad(m)}:${pad(s)}`;
        }

        function getExamScheduleStatus(settings) {
            const now = new Date();
            const start = settings.startAt ? new Date(settings.startAt) : null;
            const end = settings.endAt ? new Date(settings.endAt) : null;

            if (start && !Number.isNaN(start.getTime()) && now < start) {
                return {
                    canStart: false,
                    label: 'Belum Dibuka',
                    badgeClass: 'bg-amber-50 text-amber-700 border-amber-200',
                    reason: `Ujian baru dibuka pada ${formatDateTimeDisplay(settings.startAt)}`
                };
            }

            if (end && !Number.isNaN(end.getTime()) && now > end) {
                return {
                    canStart: false,
                    label: 'Ujian Ditutup',
                    badgeClass: 'bg-rose-50 text-rose-700 border-rose-200',
                    reason: `Waktu ujian telah berakhir pada ${formatDateTimeDisplay(settings.endAt)}`
                };
            }

            return {
                canStart: true,
                label: 'Sedang Berlangsung',
                badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200',
                reason: 'Ujian terbuka dan siap dikerjakan.'
            };
        }

        window.showModalMessage = function(title, message, variant = 'info') {
            const modal = document.getElementById('globalModal');
            const box = document.getElementById('globalModalBox');
            if (!modal || !box) return;

            const styles = {
                success: { bg: 'bg-emerald-50 text-emerald-700', icon: 'fa-circle-check' },
                warning: { bg: 'bg-amber-50 text-amber-700', icon: 'fa-triangle-exclamation' },
                error: { bg: 'bg-rose-50 text-rose-700', icon: 'fa-circle-xmark' },
                info: { bg: 'bg-blue-50 text-blue-700', icon: 'fa-circle-info' }
            };
            const st = styles[variant] || styles.info;

            modal.classList.remove('hidden');
            modal.classList.add('flex');

            box.innerHTML = `
                <div class="w-12 h-12 rounded-2xl ${st.bg} flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid ${st.icon}"></i>
                </div>
                <h3 class="text-lg font-extrabold text-slate-900 mb-1.5">${escapeHtml(title)}</h3>
                <p class="text-sm text-slate-600 leading-relaxed mb-6">${escapeHtml(message)}</p>
                <div class="flex justify-end">
                    <button type="button" onclick="closeGlobalModal()" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-extrabold">
                        Mengerti
                    </button>
                </div>
            `;
        };

        window.closeGlobalModal = function() {
            const modal = document.getElementById('globalModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        };

        window.exportParticipantsCSV = function() {
            if (!isCurrentUserAdmin()) return;
            const students = appState.users.filter(u => u.role === 'student');
            const headers = ['Nama Lengkap', 'Username', 'ID Peserta', 'Jalur', 'Instansi', 'Kelas', 'Skor PG/PGK', 'Skor Uraian', 'Nilai Akhir', 'Pelanggaran'];
            const rows = students.map(st => {
                const sub = appState.submissions.find(item => item.userId === st.id);
                return [
                    st.fullName,
                    st.username,
                    st.participantId || '',
                    st.category === 'instansi' ? 'Instansi Sekolah' : 'Mandiri',
                    st.institution || '',
                    st.classGroup || '',
                    sub ? sub.autoScore : 0,
                    sub ? sub.essayScore : 0,
                    sub ? sub.finalScore : 0,
                    sub ? sub.violationsCount : 0
                ].map(val => `"${String(val).replace(/"/g, '""')}"`).join(',');
            });

            const csvContent = '\uFEFF' + [headers.join(','), ...rows].join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `rekap-nilai-new-base-test-${new Date().toISOString().slice(0, 10)}.csv`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        };

        // ==================== 4. AUTH & NAVIGASI LOGIN ====================
        window.setLoginRole = function(role) {
            loginRole = role;
            renderApp();
        };

        window.setLoginTrack = function(track) {
            loginTrack = track;
            renderApp();
        };

        window.handleAdminInitialSetup = async function(e) {
            e.preventDefault();
            const fullName = document.getElementById('setupAdminName').value.trim();
            const institution = document.getElementById('setupAdminInst').value.trim();
            const username = document.getElementById('setupAdminUser').value.trim();
            const password = document.getElementById('setupAdminPass').value.trim();
            const adminPin = document.getElementById('setupAdminPin').value.trim();
            const errBox = document.getElementById('loginError');

            if (!fullName || !username || !password) {
                errBox.textContent = 'Nama lengkap, username, dan password wajib diisi.';
                errBox.classList.remove('hidden');
                return;
            }

            if (adminPin && adminPin.length < 4) {
                errBox.textContent = 'Kode Akses / PIN Admin minimal 4 karakter.';
                errBox.classList.remove('hidden');
                return;
            }

            const duplicate = appState.users.find(u => u.username.toLowerCase() === username.toLowerCase());
            if (duplicate) {
                errBox.textContent = 'Username tersebut sudah digunakan oleh akun lain.';
                errBox.classList.remove('hidden');
                return;
            }

            const newAdmin = {
                id: 'u_admin_' + Date.now(),
                fullName,
                participantId: adminPin ? `PIN-${adminPin}` : 'ADM',
                username,
                password,
                role: 'admin',
                category: 'instansi',
                institution: institution || 'Penyelenggara Ujian',
                classGroup: 'Administrator'
            };

            appState.users.push(newAdmin);
            currentUser = newAdmin;
            activeMenu = 'ujian';
            localStorage.setItem(SESSION_KEY, JSON.stringify(currentUser));
            await persistCloudState();
            renderApp();
        };

        window.handleLogin = function(e) {
            e.preventDefault();
            const usernameInput = document.getElementById('loginUsername').value.trim();
            const passwordInput = document.getElementById('loginPassword').value.trim();
            const errBox = document.getElementById('loginError');

            const matched = appState.users.find(u =>
                u.username.toLowerCase() === usernameInput.toLowerCase() &&
                u.password === passwordInput &&
                u.role === loginRole
            );

            if (!matched) {
                errBox.textContent = loginRole === 'admin'
                    ? 'Username atau password Administrator tidak sesuai.'
                    : 'Username atau password Peserta tidak ditemukan.';
                errBox.classList.remove('hidden');
                return;
            }

            if (loginRole === 'student' && matched.category !== loginTrack) {
                const jalurAsli = matched.category === 'instansi' ? 'Instansi Sekolah' : 'Mandiri / Sendiri';
                errBox.textContent = `Akun ini terdaftar pada jalur "${jalurAsli}". Silakan pilih jalur tersebut di atas.`;
                errBox.classList.remove('hidden');
                return;
            }

            currentUser = matched;
            activeMenu = 'ujian';
            localStorage.setItem(SESSION_KEY, JSON.stringify(currentUser));

            if (currentUser.role === 'student' && appState.inProgressSessions[currentUser.id]) {
                activeExamSession = appState.inProgressSessions[currentUser.id];
                attachAntiCheatListeners();
                startExamTimerLoop();
            }

            renderApp();
        };

        window.handleLogout = function() {
            stopExamProctoring();
            activeExamSession = null;
            currentUser = null;
            activeMenu = 'ujian';
            localStorage.removeItem(SESSION_KEY);
            renderApp();
        };

        window.setActiveMenu = function(menuId) {
            activeMenu = menuId;
            renderApp();
        };

