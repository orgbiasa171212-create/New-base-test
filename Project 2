                }
            }

            appState.users = appState.users.filter(u => u.id !== userId);
            appState.submissions = appState.submissions.filter(s => s.userId !== userId);
            delete appState.inProgressSessions[userId];

            await persistCloudState();
            if (userId === currentUser.id) {
                handleLogout();
                return;
            }
            renderApp();
        };

