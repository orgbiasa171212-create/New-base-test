        window.startExamSessionNow = async function() {
            closeDynamicModal();
            const s = appState.examSettings;

            if (s.requireFullscreen && document.documentElement.requestFullscreen) {
                try {
                    isRequestingFullscreen = true;
                    await document.documentElement.requestFullscreen();
                } catch (_) {
                    // Abaikan jika browser menolak fullscreen otomatis
                } finally {
                    setTimeout(() => { isRequestingFullscreen = false; }, 500);
                }
            }

            let orderedQuestions = [...appState.questions];
            if (s.shuffleQuestions) {
                for (let i = orderedQuestions.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [orderedQuestions[i], orderedQuestions[j]] = [orderedQuestions[j], orderedQuestions[i]];
                }
            }

            activeExamSession = {
                userId: currentUser.id,
                questionOrder: orderedQuestions.map(q => q.id),
                currentIndex: 0,
                answers: {},
                flagged: {},
                violations: [],
                remainingSeconds: s.useTimer ? (Number(s.durationMinutes) || 60) * 60 : null,
                startedAt: new Date().toISOString()
            };

            appState.inProgressSessions[currentUser.id] = activeExamSession;
            await persistCloudState();

            attachAntiCheatListeners();
            startExamTimerLoop();
            renderApp();
        };

        function attachVideoToExamRoom() {
            const vid = document.getElementById('activeProctorVideo');
            if (vid && cameraStream && !isSimulatedCamera) {
                vid.srcObject = cameraStream;
            }
        }

        function startExamTimerLoop() {
            if (examTimerInterval) clearInterval(examTimerInterval);
            if (!activeExamSession || activeExamSession.remainingSeconds === null) return;

            examTimerInterval = setInterval(async () => {
                if (!activeExamSession) {
                    clearInterval(examTimerInterval);
                    return;
                }
                activeExamSession.remainingSeconds -= 1;
                const timerEl = document.getElementById('examTimerDisplay');
                if (timerEl) {
                    timerEl.textContent = formatSeconds(activeExamSession.remainingSeconds);
                }

                if (activeExamSession.remainingSeconds % 15 === 0) {
                    appState.inProgressSessions[currentUser.id] = activeExamSession;
                    saveLocalMirror(appState);
                }

                if (activeExamSession.remainingSeconds <= 0) {
                    clearInterval(examTimerInterval);
                    await submitActiveExam(true, 'Waktu pengerjaan ujian telah habis.');
                }
            }, 1000);
        }

        // Deteksi Pelanggaran Anti-Kecurangan
        function handleVisibilityViolation() {
            if (!activeExamSession || !currentUser || currentUser.role !== 'student') return;
            if (document.hidden) {
                recordExamViolation('Meninggalkan tab / meminimalkan jendela browser');
            }
        }

        function handleWindowBlurViolation() {
            if (!activeExamSession || !currentUser || currentUser.role !== 'student') return;
            recordExamViolation('Fokus jendela berpindah ke aplikasi lain');
        }

        function handleFullscreenViolation() {
            if (!activeExamSession || !currentUser || currentUser.role !== 'student') return;
            if (isRequestingFullscreen) return;
            if (appState.examSettings.requireFullscreen && !document.fullscreenElement) {
                recordExamViolation('Keluar dari mode Layar Penuh (Fullscreen)');
            }
        }

        function handleContextMenuBlock(e) {
            if (activeExamSession && currentUser && currentUser.role === 'student') {
                e.preventDefault();
            }
        }

        function handleCopyPasteBlock(e) {
            if (activeExamSession && currentUser && currentUser.role === 'student') {
                e.preventDefault();
                recordExamViolation('Mencoba menyalin / menempel teks selama ujian');
            }
        }

        function attachAntiCheatListeners() {
            detachAntiCheatListeners();
            document.addEventListener('visibilitychange', handleVisibilityViolation);
            window.addEventListener('blur', handleWindowBlurViolation);
            document.addEventListener('fullscreenchange', handleFullscreenViolation);
            document.addEventListener('contextmenu', handleContextMenuBlock);
            document.addEventListener('copy', handleCopyPasteBlock);
            document.addEventListener('paste', handleCopyPasteBlock);
        }

        function detachAntiCheatListeners() {
            document.removeEventListener('visibilitychange', handleVisibilityViolation);
            window.removeEventListener('blur', handleWindowBlurViolation);
            document.removeEventListener('fullscreenchange', handleFullscreenViolation);
            document.removeEventListener('contextmenu', handleContextMenuBlock);
            document.removeEventListener('copy', handleCopyPasteBlock);
            document.removeEventListener('paste', handleCopyPasteBlock);
        }

        function stopExamProctoring() {
            detachAntiCheatListeners();
            if (examTimerInterval) {
                clearInterval(examTimerInterval);
                examTimerInterval = null;
            }
            if (cameraStream) {
                cameraStream.getTracks().forEach(t => t.stop());
                cameraStream = null;
            }
            if (document.fullscreenElement && document.exitFullscreen) {
                document.exitFullscreen().catch(() => {});
            }
        }

        async function recordExamViolation(reason) {
            if (!activeExamSession) return;
            const now = Date.now();
            const last = activeExamSession.violations[activeExamSession.violations.length - 1];
            if (last && (now - new Date(last.timestamp).getTime()) < 2500) {
                return;
            }

            activeExamSession.violations.push({
                reason,
                timestamp: new Date().toISOString()
            });

            appState.inProgressSessions[currentUser.id] = activeExamSession;
            await persistCloudState();

            const count = activeExamSession.violations.length;
            const max = Number(appState.examSettings.maxViolations) || 3;

            if (count >= max) {
                await submitActiveExam(true, `Batas maksimal pelanggaran (${max}x) telah tercapai: ${reason}`);
                return;
            }

            renderApp();
            showModalMessage(
                `Peringatan Pelanggaran (${count}/${max})`,
                `Sistem mendeteksi aktivitas mencurigakan: "${reason}". Jika mencapai ${max} kali, ujian akan otomatis dikumpulkan.`,
                'warning'
            );
        }

