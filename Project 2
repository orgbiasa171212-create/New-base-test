        async function submitActiveExam(isForced, note) {
            if (!activeExamSession || !currentUser) return;

            let autoScore = 0;
            let maxAutoPoints = 0;
            let hasEssay = false;

            appState.questions.forEach(q => {
                const pts = Number(q.points) || 0;
                const ans = activeExamSession.answers[q.id];

                if (q.type === 'pg') {
                    maxAutoPoints += pts;
                    if (ans === q.correctAnswer) autoScore += pts;
                } else if (q.type === 'pg_kompleks') {
                    maxAutoPoints += pts;
                    const expected = [...(q.correctAnswers || [])].sort((a, b) => a - b);
                    const actual = Array.isArray(ans) ? [...ans].sort((a, b) => a - b) : [];
                    if (expected.length === actual.length && expected.every((v, i) => v === actual[i])) {
                        autoScore += pts;
                    }
                } else if (q.type === 'uraian') {
                    hasEssay = true;
                }
            });

            const submissionRecord = {
                id: 'sub_' + Date.now(),
                userId: currentUser.id,
                fullName: currentUser.fullName,
                username: currentUser.username,
                category: currentUser.category,
                institution: currentUser.institution || '-',
                answers: { ...activeExamSession.answers },
                autoScore,
                maxAutoPoints,
                essayScore: 0,
                finalScore: autoScore,
                essayGraded: !hasEssay,
                violations: [...(activeExamSession.violations || [])],
                violationsCount: (activeExamSession.violations || []).length,
                cameraMode: isSimulatedCamera ? 'Simulasi Pengawasan' : 'Kamera Langsung Aktif',
                submittedAt: new Date().toISOString(),
                note
            };

            appState.submissions = appState.submissions.filter(s => s.userId !== currentUser.id);
            appState.submissions.push(submissionRecord);
            delete appState.inProgressSessions[currentUser.id];

            stopExamProctoring();
            activeExamSession = null;
            activeMenu = 'nilai';

            await persistCloudState();
            renderApp();

            showModalMessage(
                isForced ? 'Ujian Otomatis Dikumpulkan' : 'Ujian Berhasil Dikumpulkan',
                note,
                isForced ? 'warning' : 'success'
            );
        }

