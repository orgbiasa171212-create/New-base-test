        // State pengerjaan ujian aktif (siswa)
        let activeExamSession = null;
        let examTimerInterval = null;
        let cameraStream = null;
        let isSimulatedCamera = false;
        let isRequestingFullscreen = false;

        function getDefaultScheduleISO() {
            const now = new Date();
            const start = new Date(now.getTime() - 1000 * 60 * 60);
            const end = new Date(now.getTime() + 1000 * 60 * 60 * 24 * 7);

            const toLocalInput = (d) => {
                const pad = (n) => String(n).padStart(2, '0');
                return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
            };

            return {
                startAt: toLocalInput(start),
                endAt: toLocalInput(end)
            };
        }

