        async function initCloudAndApp() {
            const localCached = loadLocalMirror();
            if (localCached) {
                appState = localCached;
            }

            try {
                const rawSession = localStorage.getItem(SESSION_KEY);
                if (rawSession) {
                    const parsedUser = JSON.parse(rawSession);
                    const freshUser = appState.users.find(u => u.id === parsedUser.id);
                    if (freshUser) {
                        currentUser = freshUser;
                        if (currentUser.role === 'student' && appState.inProgressSessions[currentUser.id]) {
                            activeExamSession = appState.inProgressSessions[currentUser.id];
                            attachAntiCheatListeners();
                            startExamTimerLoop();
                        }
                    } else {
                        localStorage.removeItem(SESSION_KEY);
                    }
                }
            } catch (_) {
                localStorage.removeItem(SESSION_KEY);
            }

            renderApp();

            try {
                if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                    const firebaseConfig = typeof __firebase_config === 'string'
                        ? JSON.parse(__firebase_config)
                        : __firebase_config;

                    const fbApp = initializeApp(firebaseConfig);
                    auth = getAuth(fbApp);
                    db = getFirestore(fbApp);

                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        const cred = await signInWithCustomToken(auth, __initial_auth_token);
                        authUser = cred.user;
                    } else {
                        const cred = await signInAnonymously(auth);
                        authUser = cred.user;
                    }

                    const stateDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'cbt_state', 'master');
                    const snap = await getDoc(stateDocRef);
                    if (!snap.exists()) {
                        await setDoc(stateDocRef, {
                            examSettings: appState.examSettings,
                            users: appState.users,
                            questions: appState.questions,
                            submissions: appState.submissions,
                            inProgressSessions: JSON.stringify(appState.inProgressSessions || {}),
                            updatedAt: new Date().toISOString()
                        });
                    }

                    if (unsubscribeCloud) unsubscribeCloud();
                    unsubscribeCloud = onSnapshot(stateDocRef, (docSnap) => {
                        if (!docSnap.exists() || isRemoteUpdating) return;
                        isRemoteUpdating = true;
                        try {
                            appState = normalizeCloudDoc(docSnap.data());
                            saveLocalMirror(appState);

                            if (currentUser) {
                                const updatedCurrent = appState.users.find(u => u.id === currentUser.id);
                                if (updatedCurrent) {
                                    currentUser = updatedCurrent;
                                    localStorage.setItem(SESSION_KEY, JSON.stringify(currentUser));
                                } else {
                                    handleLogout();
                                    return;
                                }
                            }
                            updateSyncStatusBadge('Cloud Tersinkronisasi');
                            renderApp();
                        } finally {
                            isRemoteUpdating = false;
                        }
                    }, (err) => {
                        console.warn('Listener Firestore terputus:', err);
                        updateSyncStatusBadge('Tersimpan Lokal (Mode Offline)');
                    });
                } else {
                    updateSyncStatusBadge('Penyimpanan Lokal Aktif');
                }
            } catch (err) {
                console.warn('Fallback ke penyimpanan lokal:', err);
                updateSyncStatusBadge('Penyimpanan Lokal Aktif');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            initCloudAndApp();
        });
    </script>
</body>
</html>
