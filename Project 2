        window.saveQuestionForm = async function(e, existingId) {
            e.preventDefault();
            if (!isCurrentUserAdmin()) return;

            const type = document.getElementById('qFormType').value;
            const points = Math.max(1, Number(document.getElementById('qFormPoints').value) || 10);
            const question = document.getElementById('qFormText').value.trim();

            let options = [];
            let correctAnswer = null;
            let correctAnswers = [];

            if (type !== 'uraian') {
                for (let i = 0; i < 4; i++) {
                    const txt = document.getElementById(`qOptText_${i}`).value.trim();
                    if (!txt) {
                        showModalMessage('Data Belum Lengkap', `Pilihan jawaban ${String.fromCharCode(65 + i)} wajib diisi.`, 'warning');
                        return;
                    }
                    options.push(txt);
                    if (document.getElementById(`qOptCorrect_${i}`).checked) {
                        correctAnswers.push(i);
                    }
                }
                if (correctAnswers.length === 0) {
                    showModalMessage('Kunci Jawaban Kosong', 'Pilih minimal satu kunci jawaban benar.', 'warning');
                    return;
                }
                if (type === 'pg') {
                    correctAnswer = correctAnswers[0];
                }
            }

            const payload = {
                id: existingId || ('q_' + Date.now()),
                type,
                question,
                options,
                correctAnswer,
                correctAnswers,
                points
            };

            if (existingId) {
                const idx = appState.questions.findIndex(q => q.id === existingId);
                if (idx !== -1) appState.questions[idx] = payload;
            } else {
                appState.questions.push(payload);
            }

            await persistCloudState();
            closeDynamicModal();
            renderApp();
        };

