        window.toggleMultiOption = function(qId, optionIdx) {
            if (!activeExamSession) return;
            const prev = Array.isArray(activeExamSession.answers[qId]) ? [...activeExamSession.answers[qId]] : [];
            const pos = prev.indexOf(optionIdx);
            if (pos === -1) prev.push(optionIdx);
            else prev.splice(pos, 1);
            activeExamSession.answers[qId] = prev.sort((a, b) => a - b);
            appState.inProgressSessions[currentUser.id] = activeExamSession;
            saveLocalMirror(appState);
            renderApp();
