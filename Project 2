        window.saveUserAccountForm = async function(e, existingId) {
            e.preventDefault();
            if (!isCurrentUserAdmin()) return;

            const role = document.getElementById('uFormRole').value;
            const category = document.getElementById('uFormCategory').value;
            const fullName = document.getElementById('uFormFullName').value.trim();
            const participantId = document.getElementById('uFormPartId').value.trim();
            const username = document.getElementById('uFormUsername').value.trim();
            const password = document.getElementById('uFormPassword').value.trim();
            const institution = document.getElementById('uFormInstitution').value.trim();
            const classGroup = document.getElementById('uFormClass').value.trim();

            const duplicate = appState.users.find(u =>
                u.username.toLowerCase() === username.toLowerCase() && u.id !== existingId
            );
            if (duplicate) {
                showModalMessage('Username Sudah Digunakan', 'Silakan gunakan username lain yang unik.', 'warning');
                return;
            }

            const payload = {
                id: existingId || ('u_' + Date.now()),
                role,
                category,
                fullName,
                participantId: participantId || (role === 'admin' ? 'ADM' : 'PST-' + Math.floor(1000 + Math.random() * 9000)),
                username,
                password,
                institution: institution || (category === 'mandiri' ? 'Peserta Mandiri' : '-'),
                classGroup: classGroup || (role === 'admin' ? 'Administrator' : 'Umum')
            };

            if (existingId) {
                const idx = appState.users.findIndex(u => u.id === existingId);
                if (idx !== -1) appState.users[idx] = payload;
                if (currentUser.id === existingId) {
                    currentUser = payload;
                    localStorage.setItem(SESSION_KEY, JSON.stringify(currentUser));
                }
            } else {
                appState.users.push(payload);
            }

            await persistCloudState();
            closeDynamicModal();
            renderApp();
        };

        window.deleteUserAccount = async function(userId) {
            if (!isCurrentUserAdmin()) return;
            const target = appState.users.find(u => u.id === userId);
            if (!target) return;

            if (target.role === 'admin') {
                const adminCount = appState.users.filter(u => u.role === 'admin').length;
                if (adminCount <= 1) {
                    showModalMessage('Tidak Dapat Menghapus', 'Minimal harus tersisa satu akun Administrator aktif di dalam sistem.', 'warning');
